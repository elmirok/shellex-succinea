{
  "id": "system.succinea.local",
  "name": "Succinea",
  "version": "1.0.2",
  "author": "Shellex",
  "description": "A delicate status bar for time, Shellex version, W3 desktop switching, runtime memory and vault storage.",
  "repository": "https://github.com/elmirok/shellex-succinea",
  "type": "system-app",
  "entry": "README.md",
  "runtime": "host",
  "permissions": [
    "system:status",
    "settings:write:/system/succinea/config.json"
  ],
  "window": {
    "width": 0,
    "height": 0,
    "resizable": false
  }
}
